<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Console appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS} %-5level [%X{orderId}] %logger{36} : %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Loki appender (ONLY ONE - FIXED) -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">

        <http>
            <url>${LOKI_PUSH_URL}</url>

            <auth>
                <basic>
                    <username>${LOKI_USERNAME}</username>
                    <password>${LOKI_API_KEY}</password>
                </basic>
            </auth>
        </http>

        <format>
            <label>
                <pattern>app=queue-x-workers,level=%level</pattern>
            </label>

            <message>
                <pattern>
                    {
                    "timestamp": "%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}",
                    "level": "%level",
                    "logger": "%logger{36}",
                    "thread": "%thread",
                    "orderId": "%X{orderId:-}",
                    "message": "%msg"
                    }
                </pattern>
            </message>
        </format>

    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOKI"/>
    </root>

</configuration>